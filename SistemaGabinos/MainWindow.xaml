<Window x:Class="SistemaGabinos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SistemaGabinos.Controls"
        xmlns:local="clr-namespace:SistemaGabinos"
        mc:Ignorable="d"
        Title="Teacher Gabinos" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FontPoppins}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BrushSurfaceAlt}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo area -->
                <Border Padding="24,28" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Height="90" VerticalAlignment="Top" Margin="0,-20,0,0">
                    <TextBlock Text="GABINOS"
                               Foreground="{StaticResource BrushText}"
                               FontSize="22"
                               FontWeight="Bold" Margin="0,17,0,-17" />
                </Border>

                <!-- Navigation items -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <RadioButton Content="Panel de Control"
                                 Style="{StaticResource SidebarItem}"
                                 IsChecked="True"
                                 Click="FunctionPanel_Click" />
                    <RadioButton Content="Nueva Inscripcion"
                                 Style="{StaticResource SidebarItem}"
                                 Click="NewEnrollment" />
                    <RadioButton Content="Reportes y Finanzas"
                                 Style="{StaticResource SidebarItem}"
                                 Click="ReportesFinanzas_Click" />
                    <RadioButton Content="Configuración"
                                 Style="{StaticResource SidebarItem}"
                                 Click="Button_Click" />
                </StackPanel>

                <!-- Logout -->
                
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:SearchAutocomplete Grid.Column="0"
                        x:Name="SearchBox"
                        PlaceholderText="Buscar alumno por nombre o CURP..."
                        SearchText="{Binding CriterioBusqueda, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding ResultadosBusqueda}"
                        SelectedItem="{Binding AlumnoSeleccionado}"
                        IsDropdownOpen="{Binding DropdownAbierto}"
                        VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
            </Border>

            <!-- Page Frame -->
            <Frame x:Name="PrimaryContainer"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Background="{StaticResource BrushSurfaceAlt}" />
        </Grid>
    </Grid>
</Window>