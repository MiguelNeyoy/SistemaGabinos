<Window x:Class="SistemaGabinos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaGabinos"
        mc:Ignorable="d"
        Title="Teacher Gabinos" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FontPoppins}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BrushSurfaceAlt}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo area -->
                <Border Grid.Row="0" Padding="24,28" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                    <TextBlock Text="GABINOS"
                               Foreground="{StaticResource BrushText}"
                               FontSize="22"
                               FontWeight="Bold" />
                </Border>

                <!-- Navigation items -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <RadioButton Content="Panel de Control"
                                 Style="{StaticResource SidebarItem}"
                                 IsChecked="True"
                                 Click="FunctionPanel_Click" />
                    <RadioButton Content="Nueva Matrícula"
                                 Style="{StaticResource SidebarItem}"
                                 Click="NewEnrollment" />
                    <RadioButton Content="Ventanilla de Cobro"
                                 Style="{StaticResource SidebarItem}" />
                    <RadioButton Content="Configuración"
                                 Style="{StaticResource SidebarItem}"
                                 Click="Button_Click" />
                </StackPanel>

                <!-- Logout -->
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Panel de Control"
                               Style="{StaticResource TitleLarge}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Background="{StaticResource BrushSurfaceAlt}"
                                CornerRadius="20"
                                Padding="12,6">
                            <TextBlock Text="Admin"
                                       Style="{StaticResource LabelMedium}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page Frame -->
            <Frame x:Name="PrimaryContainer"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Background="{StaticResource BrushSurfaceAlt}" />
        </Grid>
    </Grid>
</Window>