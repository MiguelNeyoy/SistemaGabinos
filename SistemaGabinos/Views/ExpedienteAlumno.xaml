<Page x:Class="SistemaGabinos.Views.ExpedienteAlumno"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Expediente del Alumno"
      Background="{StaticResource BrushSurfaceAlt}"
      FontFamily="{StaticResource FontPoppins}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="RightAlignedColumn" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="CenterAlignedColumn" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Title -->
        <TextBlock Grid.Row="0"
                   Text="Expediente del Alumno"
                   Style="{StaticResource HeadlineLarge}"
                   Margin="0,0,0,20" />

        <!-- Student Profile Header Card (Exact Stitch Match) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Avatar with Online/Active Badge -->
                <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Border Width="88" Height="88" CornerRadius="12"
                            Background="{StaticResource BrushSurfaceAlt}"
                            BorderBrush="{StaticResource BrushPrimary}"
                            BorderThickness="2">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="44"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <!-- Active Green Badge -->
                    <Border Width="18" Height="18" CornerRadius="9"
                            Background="#22C55E"
                            BorderBrush="{StaticResource BrushWhite}"
                            BorderThickness="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,-3,-3" />
                </Grid>

                <!-- Line 1: Name + Status Badge + Beca Badge -->
                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Alumno.NombreCompleto}"
                               Style="{StaticResource HeadlineLarge}"
                               FontSize="26"
                               VerticalAlignment="Center" />
                    <Border CornerRadius="20"
                            Padding="12,4"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#DCFCE7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsActivo}" Value="False">
                                        <Setter Property="Background" Value="#FEE2E2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Alumno.Estado, FallbackValue='ACTIVO'}"
                                   FontSize="11"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#166534" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsActivo}" Value="False">
                                            <Setter Property="Foreground" Value="#991B1B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Dynamic Beca Badge -->
                    <Border Background="#FEF3C7"
                            CornerRadius="20"
                            Padding="12,4"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding TieneBeca, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="★ BECA ACTIVA"
                                   Foreground="#92400E"
                                   FontSize="11"
                                   FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Line 2: Matricula / Level -->
                <TextBlock Grid.Column="1" Grid.Row="1"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="0,4,0,0">
                    Matrícula: <Run FontWeight="SemiBold" Text="{Binding Alumno.Id}" /> • Nivel Actual: <Run FontWeight="SemiBold" Text="{Binding Alumno.CursoActual, FallbackValue='Sin Nivel'}" />
                </TextBlock>

                <!-- Line 3: Metadata CURP, Phone, Tutor & Financial Conditions -->
                <WrapPanel Grid.Column="1" Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource BodyMedium}" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,24,0">
                        CURP: <Run FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Text="{Binding Alumno.Curp}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyMedium}" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,24,0">
                        Teléfono: <Run FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Text="{Binding Alumno.Telefono}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyMedium}" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,24,0">
                        Tutor: <Run FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Text="{Binding Alumno.NombreTutor}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyMedium}" Foreground="{StaticResource BrushTextMuted}">
                        Mensualidad: <Run FontWeight="Bold" Foreground="{StaticResource BrushText}" Text="{Binding Alumno.MensualidadNeta, StringFormat={}{0:C}}" />
                    </TextBlock>
                </WrapPanel>

                <!-- Action Buttons (Right Aligned in 1 Clean Row) -->
                <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Exportar PDF"
                                Style="{StaticResource ButtonSecondary}"
                                Command="{Binding ExportarPdfCommand}"
                                Padding="16,8"
                                Margin="0,0,8,0" />
                        <Button Content="Editar"
                                Style="{StaticResource ButtonSecondary}"
                                Command="{Binding EditarCommand}"
                                Padding="16,8"
                                Margin="0,0,8,0" />
                        <!-- Botón Estado Dinámico (Dar de Baja / Reactivar) -->
                        <Button Padding="14,6" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                    <Setter Property="Content" Value="Dar de Baja" />
                                    <Setter Property="Command" Value="{Binding DarDeBajaCommand}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsActivo}" Value="False">
                                            <Setter Property="Content" Value="✓ Reactivar Alumno" />
                                            <Setter Property="Command" Value="{Binding ReactivarCommand}" />
                                            <Setter Property="Background" Value="#DCFCE7" />
                                            <Setter Property="Foreground" Value="#166534" />
                                            <Setter Property="BorderBrush" Value="#86EFAC" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Pagar"
                                Style="{StaticResource ButtonPrimary}"
                                Command="{Binding PagarCommand}"
                                Padding="22,8" />
                    </StackPanel>

                    <!-- Feedback Message -->
                    <TextBlock Text="{Binding MensajeExpediente}"
                               Foreground="{StaticResource BrushPrimary}"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab System Bar (Single Active Tab: Historial Financiero) -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabHistorialFinanciero"
                             Content="Historial Financiero"
                             IsChecked="True"
                             Style="{StaticResource TabStyle}"
                             GroupName="ExpedienteTabs" />
            </StackPanel>
        </Border>

        <!-- Main Content Area: Financial History DataGrid (Full Screen) -->
        <Grid Grid.Row="3" VerticalAlignment="Stretch">
            <Border Style="{StaticResource CardStyle}"
                    Padding="0"
                    VerticalAlignment="Stretch">
                <Grid VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FFF8F0"
                            Padding="24,16"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="HISTORIAL FINANCIERO"
                                   Style="{StaticResource LabelMedium}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextMuted}" />
                    </Border>

                    <!-- Real Dynamic Binding to ViewModel Pagos Collection -->
                    <DataGrid Grid.Row="1"
                               Style="{StaticResource TableStyle}"
                               ItemsSource="{Binding Pagos}"
                               AutoGenerateColumns="False"
                               Margin="0"
                               VerticalAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FOLIO"
                                                Binding="{Binding Folio}"
                                                Width="160" />
                            <DataGridTextColumn Header="CONCEPTO"
                                                Binding="{Binding Concepto}"
                                                Width="*" />
                            <DataGridTextColumn Header="MONTO"
                                                Binding="{Binding Monto, StringFormat={}{0:C}}"
                                                ElementStyle="{StaticResource RightAlignedColumn}"
                                                Width="160" />
                            <DataGridTemplateColumn Header="ESTADO" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="20"
                                                Padding="12,4"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Pendiente">
                                                            <Setter Property="Background" Value="#FEF3C7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#166534" />
                                                        <Setter Property="Text" Value="PAGADO" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Estado}" Value="Pendiente">
                                                                <Setter Property="Foreground" Value="#92400E" />
                                                                <Setter Property="Text" Value="PENDIENTE" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FECHA"
                                                Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}"
                                                ElementStyle="{StaticResource CenterAlignedColumn}"
                                                Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Padding="24,16"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,1,0,0"
                            Background="{StaticResource BrushSurfaceAlt}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Total Pendiente:"
                                       Style="{StaticResource TitleLarge}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TotalPendiente, StringFormat={}{0:C} MXN}"
                                       Style="{StaticResource HeadlineMedium}"
                                       Foreground="{StaticResource BrushSecondary}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
