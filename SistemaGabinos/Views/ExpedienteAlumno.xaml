<Page x:Class="SistemaGabinos.Views.ExpedienteAlumno"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Expediente del Alumno"
      Background="{StaticResource BrushSurfaceAlt}"
      FontFamily="{StaticResource FontPoppins}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="Expediente del Alumno"
                       Style="{StaticResource HeadlineLarge}"
                       Margin="0,0,0,24" />

            <Border Style="{StaticResource CardStyle}" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Alumno.NombreCompleto}"
                                       Style="{StaticResource TitleLarge}"
                                       VerticalAlignment="Center" />
                            <Border Background="#dcfce7"
                                    CornerRadius="20"
                                    Padding="10,4"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Alumno.Estado}"
                                           Foreground="#166534"
                                           FontSize="11"
                                           FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyMedium}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,4,0,0">
                                Matrícula: <Run FontWeight="SemiBold" Text="{Binding Alumno.Id}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Pagar"
                                Style="{StaticResource ButtonPrimary}"
                                Command="{Binding PagarCommand}"
                                Padding="20,8"
                                Margin="0,0,8,0" />
                        <Button Content="Editar Datos"
                                Style="{StaticResource ButtonSecondary}"
                                Command="{Binding EditarCommand}"
                                Padding="20,8" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <TextBlock Text="CURP:"
                                       Style="{StaticResource LabelMedium}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Alumno.Curp}"
                                       Style="{StaticResource BodyMedium}"
                                       Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <TextBlock Text="Teléfono:"
                                       Style="{StaticResource LabelMedium}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Alumno.Telefono}"
                                       Style="{StaticResource BodyMedium}"
                                       Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tutor:"
                                       Style="{StaticResource LabelMedium}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Alumno.NombreTutor}"
                                       Style="{StaticResource BodyMedium}"
                                       Margin="4,0,0,0" />
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <RadioButton x:Name="TabDatosPersonales"
                             Content="Datos Personales"
                             IsChecked="{Binding EsDatosPersonales}"
                             Style="{StaticResource TabStyle}"
                             GroupName="ExpedienteTabs" />
                <RadioButton x:Name="TabHistorialFinanciero"
                             Content="Historial Financiero"
                             IsChecked="{Binding EsHistorialFinanciero}"
                             Style="{StaticResource TabStyle}"
                             GroupName="ExpedienteTabs" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}"
                    Padding="24"
                    Margin="0,0,0,0"
                    Visibility="{Binding EsDatosPersonales, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Información de Contacto y Tutor"
                               Style="{StaticResource HeadlineMedium}"
                               Margin="0,0,0,24" />

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Nombre Completo"
                                       Style="{StaticResource LabelMedium}" />
                            <TextBlock Text="{Binding Alumno.NombreCompleto}"
                                       Style="{StaticResource BodyLarge}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="CURP"
                                       Style="{StaticResource LabelMedium}" />
                            <TextBlock Text="{Binding Alumno.Curp}"
                                       Style="{StaticResource BodyLarge}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="Fecha de Nacimiento"
                                       Style="{StaticResource LabelMedium}" />
                            <TextBlock Style="{StaticResource BodyLarge}"
                                       Margin="0,4,0,0">
                                <Run Text="{Binding Alumno.FechaNacimiento, StringFormat={}{0:dd/MM/yyyy}}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,20,0,0">
                            <TextBlock Text="Teléfono"
                                       Style="{StaticResource LabelMedium}" />
                            <TextBlock Text="{Binding Alumno.Telefono}"
                                       Style="{StaticResource BodyLarge}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,20,0,0">
                            <TextBlock Text="Nombre del Tutor"
                                       Style="{StaticResource LabelMedium}" />
                            <TextBlock Text="{Binding Alumno.NombreTutor}"
                                       Style="{StaticResource BodyLarge}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,20,0,0">
                            <TextBlock Text="Parentesco"
                                       Style="{StaticResource LabelMedium}" />
                            <TextBlock Text="{Binding Alumno.ParentescoTutor}"
                                       Style="{StaticResource BodyLarge}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,20,0,0">
                            <TextBlock Text="Teléfono del Tutor"
                                       Style="{StaticResource LabelMedium}" />
                            <TextBlock Text="{Binding Alumno.TelefonoTutor}"
                                       Style="{StaticResource BodyLarge}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}"
                    Padding="0"
                    Margin="0,0,0,0"
                    Visibility="{Binding EsHistorialFinanciero, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="20,14"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="Historial Financiero"
                                   Style="{StaticResource HeadlineMedium}" />
                    </Border>

                    <DataGrid Grid.Row="1"
                              Style="{StaticResource TableStyle}"
                              ItemsSource="{Binding Pagos}"
                              AutoGenerateColumns="False"
                              Margin="0" SelectionChanged="DataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Folio"
                                                Binding="{Binding Folio}"
                                                Width="120" />
                            <DataGridTextColumn Header="Concepto"
                                                Binding="{Binding Concepto}"
                                                Width="*" />
                            <DataGridTextColumn Header="Monto"
                                                Binding="{Binding Monto, StringFormat={}{0:C}}"
                                                Width="120" />
                            <DataGridTemplateColumn Header="Estado" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="20"
                                                Padding="8,4"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#dcfce7" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Pendiente">
                                                            <Setter Property="Background" Value="#fef3c7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11"
                                                       FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#166534" />
                                                    <Setter Property="Text" Value="Pagado" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Pendiente">
                                                            <Setter Property="Foreground" Value="#92400e" />
                                                            <Setter Property="Text" Value="Pendiente" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Fecha"
                                                Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Padding="20,14"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,1,0,0"
                            Background="{StaticResource BrushSurfaceAlt}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Total Pendiente:"
                                       Style="{StaticResource TitleLarge}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TotalPendiente, StringFormat={}{0:C} MXN}"
                                       Style="{StaticResource TitleLarge}"
                                       Foreground="{StaticResource BrushSecondary}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
