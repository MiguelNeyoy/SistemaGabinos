<Page x:Class="SistemaGabinos.Views.PanelDeControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:SistemaGabinos.Views"
      mc:Ignorable="d"
      Title="PanelDeControl"
      Background="{StaticResource BrushSurfaceAlt}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Quick Action Buttons -->
            <WrapPanel Margin="0,0,0,24">
                <Button Content="Inscripción"
                        Style="{StaticResource ButtonPrimary}"
                        Click="NuevaMatricula_Click" />
                <Button Content="Pagos"
                        Style="{StaticResource ButtonAccent}"
                        Margin="12,0,0,0" ></Button>
            </WrapPanel>

            <!-- Metrics Row -->
            <WrapPanel>
                <!-- Metric Card: Ingresos Totales -->

                <!-- Metric Card: Matrículas Activas -->
                <Border Style="{StaticResource CardStyle}" Width="220" Padding="20,16" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="Matrículas Activas" Style="{StaticResource MetricLabel}" Margin="0,0,0,8" />
                        <TextBlock Text="48" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="+3 esta semana" Style="{StaticResource LabelMedium}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Metric Card: Clases Hoy -->

                <!-- Metric Card: Pendientes -->
                <Border Style="{StaticResource CardStyle}" Width="220" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Pagos Pendientes" Style="{StaticResource MetricLabel}" Margin="0,0,0,8" />
                        <TextBlock Text="$2,850" Style="{StaticResource MetricValue}" Foreground="{StaticResource BrushSecondary}" />
                        <TextBlock Text="6 alumnos" Style="{StaticResource LabelMedium}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Transactions Table -->
            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Padding="20,14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Transacciones Recientes"
                                   Style="{StaticResource HeadlineMedium}" />
                    </Border>

                    <!-- Table Body -->
                    <DataGrid Grid.Row="1" Style="{StaticResource TableStyle}" Margin="0"
                              xmlns:sys="clr-namespace:System;assembly=mscorlib">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Alumno" Width="120" />
                            <DataGridTextColumn Header="Concepto" Width="120" />
                            <DataGridTextColumn Header="Monto" Width="120" />
                            <DataGridTextColumn Header="Fecha" Width="140" />
                            <DataGridTextColumn Header="Estado" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>