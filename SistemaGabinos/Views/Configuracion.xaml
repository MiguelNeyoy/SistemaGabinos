<Page x:Class="SistemaGabinos.Views.Configuracion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Configuración General"
      Background="{StaticResource BrushSurfaceAlt}"
      FontFamily="{StaticResource FontPoppins}">
    <Page.Resources>
        <!-- Base Style for Placeholder TextBlock -->
        <Style x:Key="PlaceholderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Title & Subtitle Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource BrushPrimary}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Configuración General de Costos"
                                   Style="{StaticResource HeadlineLarge}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Administra las tarifas globales de inscripción, exámenes y libros."
                               Style="{StaticResource BodyMedium}"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="40,4,0,0" />
                </StackPanel>

                <!-- Top Save Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding GuardarCambiosCommand}"
                        Padding="24,10"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Guardar Cambios"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Reusable Notification Banner (Success) -->
            <Border Background="#DCFCE7"
                    BorderBrush="#86EFAC"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeExito}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MensajeExito}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE73E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="#166534"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding MensajeExito}"
                               Foreground="#166534"
                               Style="{StaticResource BodyMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Reusable Notification Banner (Error / Exception) -->
            <Border Background="#FFDAD6"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MensajeError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE783;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="#93000A"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding MensajeError}"
                               Foreground="#93000A"
                               Style="{StaticResource BodyMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Section 1: Costos Académicos Base -->
            <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Costos Académicos Base"
                                   Style="{StaticResource HeadlineMedium}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Inscripción -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Inscripción Estándar ($)"
                                       Style="{StaticResource LabelMedium}"
                                       Margin="0,0,0,6" />
                            <Grid>
                                <TextBox x:Name="TxtInscripcion"
                                         Text="{Binding CostoInscripcion, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource InputStyle}"
                                         Padding="12,10" />
                                <TextBlock Text="{Binding CostoInscripcionBD, StringFormat='Ej. {0:N2}'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtInscripcion}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Examen de Ubicación -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Examen de Ubicación ($)"
                                       Style="{StaticResource LabelMedium}"
                                       Margin="0,0,0,6" />
                            <Grid>
                                <TextBox x:Name="TxtExamenUbicacion"
                                         Text="{Binding CostoExamenUbicacion, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource InputStyle}"
                                         Padding="12,10" />
                                <TextBlock Text="{Binding CostoExamenUbicacionBD, StringFormat='Ej. {0:N2}'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtExamenUbicacion}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Costo Base de Libro -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Costo Base de Libros ($)"
                                       Style="{StaticResource LabelMedium}"
                                       Margin="0,0,0,6" />
                            <Grid>
                                <TextBox x:Name="TxtLibro"
                                         Text="{Binding CostoLibro, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource InputStyle}"
                                         Padding="12,10" />
                                <TextBlock Text="{Binding CostoLibroBD, StringFormat='Ej. {0:N2}'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtLibro}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 3: Actualizaciones del Sistema (Velopack) -->
            <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Actualizaciones del Sistema"
                                   Style="{StaticResource HeadlineMedium}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Versión Actual Instalada: "
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding VersionActual, StringFormat='v{0}'}"
                                           Style="{StaticResource BodyMedium}"
                                           Foreground="{StaticResource BrushPrimary}"
                                           FontWeight="Bold" />
                            </StackPanel>

                            <TextBlock Text="{Binding MensajeUpdate}" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HayNuevaVersion}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Barra de Progreso de Descarga -->
                            <StackPanel Margin="0,12,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsDescargandoUpdate}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                    <ProgressBar Value="{Binding ProgresoDescarga}"
                                                 Minimum="0" Maximum="100" Height="8" />
                                    <TextBlock Text="{Binding ProgresoDescarga, StringFormat='{}{0}%'}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" 
                                               FontSize="10" 
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Margin="0,0,0,0" />
                                </Grid>
                                <TextBlock Text="Descargando nueva versión, por favor espera..." 
                                           FontSize="11" 
                                           Foreground="{StaticResource BrushTextMuted}" 
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Botones de Acción de Actualización -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding BuscarActualizacionesCommand}"
                                    Padding="16,10"
                                    Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsDescargandoUpdate}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Buscar Actualizaciones"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding AplicarActualizacionCommand}"
                                    Padding="16,10">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HayNuevaVersion}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EsDescargandoUpdate}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Descargar y Aplicar"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bottom Action Footer -->
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Guardar Cambios de Configuración"
                                   Style="{StaticResource TitleLarge}" />
                        <TextBlock Text="Los nuevos costos se aplicarán a todas las inscripciones y cobros posteriores."
                                   Style="{StaticResource BodyMedium}"
                                   Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding GuardarCambiosCommand}"
                            Padding="28,12"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="GUARDAR CAMBIOS"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
