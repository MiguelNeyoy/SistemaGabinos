<Page x:Class="SistemaGabinos.Views.Configuracion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Configuración General"
      Background="{StaticResource BrushSurfaceAlt}"
      FontFamily="{StaticResource FontPoppins}">
    <Page.Resources>
        <!-- Base Style for Placeholder TextBlock -->
        <Style x:Key="PlaceholderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Title & Subtitle Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource BrushPrimary}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Configuración General de Costos y Becas"
                                   Style="{StaticResource HeadlineLarge}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Administra las tarifas globales de colegiatura, inscripción, exámenes, libros y descuentos de becas."
                               Style="{StaticResource BodyMedium}"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="40,4,0,0" />
                </StackPanel>

                <!-- Top Save Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding GuardarCambiosCommand}"
                        Padding="24,10"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Guardar Cambios"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Reusable Notification Banner (Success) -->
            <Border Background="#DCFCE7"
                    BorderBrush="#86EFAC"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeExito}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MensajeExito}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE73E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="#166534"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding MensajeExito}"
                               Foreground="#166534"
                               Style="{StaticResource BodyMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Reusable Notification Banner (Error / Exception) -->
            <Border Background="#FFDAD6"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MensajeError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE783;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="#93000A"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding MensajeError}"
                               Foreground="#93000A"
                               Style="{StaticResource BodyMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Section 1: Costos Académicos Base -->
            <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="{StaticResource BrushPrimary}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Costos Académicos Base"
                                   Style="{StaticResource HeadlineMedium}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Mensualidad Base -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                            <TextBlock Text="Colegiatura Mensual Base ($)"
                                       Style="{StaticResource LabelMedium}"
                                       Margin="0,0,0,6" />
                            <Grid>
                                <TextBox x:Name="TxtMensualidad"
                                         Text="{Binding CostoMensualidad, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource InputStyle}"
                                         Padding="12,10" />
                                <TextBlock Text="Ej. 1400.00">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtMensualidad}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Inscripción -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                            <TextBlock Text="Inscripción Estándar ($)"
                                       Style="{StaticResource LabelMedium}"
                                       Margin="0,0,0,6" />
                            <Grid>
                                <TextBox x:Name="TxtInscripcion"
                                         Text="{Binding CostoInscripcion, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource InputStyle}"
                                         Padding="12,10" />
                                <TextBlock Text="Ej. 500.00">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtInscripcion}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Examen de Ubicación -->
                        <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,20">
                            <TextBlock Text="Examen de Ubicación ($)"
                                       Style="{StaticResource LabelMedium}"
                                       Margin="0,0,0,6" />
                            <Grid>
                                <TextBox x:Name="TxtExamenUbicacion"
                                         Text="{Binding CostoExamenUbicacion, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource InputStyle}"
                                         Padding="12,10" />
                                <TextBlock Text="Ej. 250.00">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtExamenUbicacion}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Costo Base de Libro -->
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Costo Base de Libros ($)"
                                       Style="{StaticResource LabelMedium}"
                                       Margin="0,0,0,6" />
                            <Grid>
                                <TextBox x:Name="TxtLibro"
                                         Text="{Binding CostoLibro, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource InputStyle}"
                                         Padding="12,10" />
                                <TextBlock Text="Ej. 350.00">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtLibro}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 2: Gestión de Becas y Descuentos -->
            <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="&#xE1D5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="{StaticResource BrushSecondary}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Gestión de Becas y Descuentos"
                                   Style="{StaticResource HeadlineMedium}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <!-- Input Monto Descuento Beca -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Monto de Descuento de la Beca ($)"
                                       Style="{StaticResource LabelMedium}"
                                       Margin="0,0,0,6" />
                            <Grid>
                                <TextBox x:Name="TxtDescuentoBeca"
                                         Text="{Binding MontoDescuentoBeca, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource InputStyle}"
                                         Padding="12,10" />
                                <TextBlock Text="Ej. 400.00">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtDescuentoBeca}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="Este descuento se resta automáticamente de la mensualidad base para alumnos con beca activa."
                                       Style="{StaticResource BodyMedium}"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Display Dual Cards: Sin Beca vs Con Beca -->
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tarifa Regular (Sin Beca) -->
                            <Border Grid.Column="0"
                                    Background="{StaticResource BrushSurfaceAlt}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="MENSUALIDAD REGULAR"
                                               Style="{StaticResource LabelMedium}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBlock Text="Sin Beca"
                                               Style="{StaticResource BodyMedium}"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,1,0,8" />
                                    <TextBlock Text="{Binding MensualidadSinBeca, StringFormat={}{0:C} MXN}"
                                               Style="{StaticResource HeadlineMedium}"
                                               Foreground="{StaticResource BrushText}"
                                               FontSize="20" />
                                </StackPanel>
                            </Border>

                            <!-- Tarifa Especial (Con Beca) -->
                            <Border Grid.Column="2"
                                    Background="#FFFCE0"
                                    BorderBrush="{StaticResource BrushPrimary}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="MENSUALIDAD CON BECA"
                                               Style="{StaticResource LabelMedium}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushSecondary}" />
                                    <TextBlock Text="Con Beca Activa"
                                               Style="{StaticResource BodyMedium}"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,1,0,8" />
                                    <TextBlock Text="{Binding MensualidadConBeca, StringFormat={}{0:C} MXN}"
                                               Style="{StaticResource HeadlineMedium}"
                                               Foreground="{StaticResource BrushSecondary}"
                                               FontSize="20" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bottom Action Footer -->
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Guardar Cambios de Configuración"
                                   Style="{StaticResource TitleLarge}" />
                        <TextBlock Text="Los nuevos costos se aplicarán a todas las inscripciones y cobros posteriores."
                                   Style="{StaticResource BodyMedium}"
                                   Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding GuardarCambiosCommand}"
                            Padding="28,12"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="GUARDAR CAMBIOS"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
