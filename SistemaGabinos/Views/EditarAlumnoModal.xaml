<Window x:Class="SistemaGabinos.Views.EditarAlumnoModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SistemaGabinos.Controls"
        Title="Editar Datos del Alumno"
        Height="620"
        Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushSurfaceAlt}"
        FontFamily="{StaticResource FontPoppins}">

    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="24"
                               Foreground="{StaticResource BrushPrimary}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Editar Datos del Alumno"
                               Style="{StaticResource HeadlineMedium}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Actualiza la información personal y el contacto de tutor/emergencia."
                           Style="{StaticResource BodyMedium}"
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="34,2,0,0" />
            </StackPanel>

            <!-- Form Body in ScrollViewer -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Personal Info Card -->
                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Información Personal"
                                       Style="{StaticResource TitleLarge}"
                                       FontSize="16"
                                       Margin="0,0,0,16" />

                            <controls:FormField Label="Nombre Completo"
                                                Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:IconInput Grid.Column="0"
                                                    Label="Teléfono de Contacto"
                                                    Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fecha de Nacimiento"
                                               Style="{StaticResource LabelMedium}"
                                               Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding FechaNacimiento, Mode=TwoWay}"
                                                FontFamily="{StaticResource FontPoppins}"
                                                FontSize="14"
                                                Height="42" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tutor / Emergency Contact Card -->
                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{Binding TituloSeccionTutor}"
                                       Style="{StaticResource TitleLarge}"
                                       FontSize="15"
                                       Foreground="{StaticResource BrushSecondary}"
                                       Margin="0,0,0,14" />

                            <controls:FormField Label="Nombre del Tutor / Contacto"
                                                Text="{Binding NombreTutor, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:FormField Grid.Column="0"
                                                    Label="Parentesco"
                                                    Text="{Binding ParentescoTutor, UpdateSourceTrigger=PropertyChanged}" />

                                <controls:FormField Grid.Column="2"
                                                    Label="Teléfono del Tutor / Contacto"
                                                    Text="{Binding TelefonoTutor, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Error Banner -->
                    <Border Background="#FFDAD6"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MensajeError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding MensajeError}"
                                   Foreground="#93000A"
                                   Style="{StaticResource BodyMedium}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Cancelar"
                        Style="{StaticResource ButtonSecondary}"
                        Padding="24,10"
                        Click="Cancelar_Click" />

                <Button Grid.Column="3"
                        Content="💾 Guardar Cambios"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding GuardarCommand}"
                        Padding="24,10" />
            </Grid>
        </Grid>
    </Border>
</Window>
