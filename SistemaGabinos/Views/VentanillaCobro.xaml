<Page x:Class="SistemaGabinos.Views.VentanillaCobro"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SistemaGabinos.Controls"
      Title="Ventanilla de Cobro Exprés"
      Background="{StaticResource BrushSurfaceAlt}"
      FontFamily="{StaticResource FontPoppins}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="InverseBooleanToVisibilityConverterStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TieneAlumnoCargado}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BooleanToVisibilityConverterStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TieneAlumnoCargado}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page Title Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource BrushPrimary}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Ventanilla de Cobro Exprés"
                                   Style="{StaticResource HeadlineLarge}"
                                   VerticalAlignment="Center" />
                        <Border Background="#FFE087"
                                CornerRadius="4"
                                Padding="8,2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="F9"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Búsqueda rápida, cobros flexibles y adición de libros en tiempo real."
                               Style="{StaticResource BodyMedium}"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="40,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Reusable Notification Banner (Success) -->
            <Border Grid.Row="1"
                    Background="#DCFCE7"
                    BorderBrush="#86EFAC"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mensaje}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Mensaje}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE73E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="#166534"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Mensaje}"
                               Foreground="#166534"
                               Style="{StaticResource BodyMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Reusable Notification Banner (Error) -->
            <Border Grid.Row="2"
                    Background="#FFDAD6"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MensajeError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE783;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="#93000A"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding MensajeError}"
                               Foreground="#93000A"
                               Style="{StaticResource BodyMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Card 1 A: Autocomplete Search Bar (Shown when NO Student is Loaded) -->
            <Border Grid.Row="3" Padding="32" Margin="0,0,0,20">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TieneAlumnoCargado}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel MaxWidth="600" HorizontalAlignment="Center" Margin="0,20,0,20">
                    <TextBlock Text="Buscar Alumno para Cobro"
                               Style="{StaticResource TitleLarge}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />
                    
                    <controls:SearchAutocomplete x:Name="SearchBox"
                        PlaceholderText="Buscar alumno por nombre o CURP..."
                        SearchText="{Binding CriterioBusqueda, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding ResultadosBusqueda}"
                        SelectedItem="{Binding AlumnoSeleccionado}"
                        IsDropdownOpen="{Binding DropdownAbierto}" />
                </StackPanel>
            </Border>

            <!-- Card 1 B: Student Profile Header (Shown when Student IS Loaded) -->
            <Border Grid.Row="3" Padding="20" Margin="0,0,0,20">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TieneAlumnoCargado}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="8"
                            Background="{StaticResource BrushSurfaceAlt}"
                            BorderBrush="{StaticResource BrushPrimary}"
                            BorderThickness="2"
                            Margin="0,0,16,0">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NombreCompleto, FallbackValue='Alumno Seleccionado'}"
                                       Style="{StaticResource TitleLarge}"
                                       FontSize="20"
                                       VerticalAlignment="Center" />
                            <Border CornerRadius="12"
                                    Padding="10,2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F3F4F4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TieneBeca}" Value="True">
                                                <Setter Property="Background" Value="#DCFCE7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                            <Setter Property="Text" Value="REGULAR" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TieneBeca}" Value="True">
                                                    <Setter Property="Foreground" Value="#166534" />
                                                    <Setter Property="Text" Value="BECADO" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Curp, StringFormat='CURP: {0}', FallbackValue='CURP: -'}"
                                   Style="{StaticResource BodyMedium}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Matrícula ID"
                                   Style="{StaticResource LabelMedium}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding AlumnoId, StringFormat={}{0:D4}}"
                                   Style="{StaticResource TitleLarge}"
                                   Foreground="{StaticResource BrushText}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Conceptos Pendientes y Formulario de Cobro -->
            <Grid Grid.Row="4" Margin="0,0,0,24">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TieneAlumnoCargado}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Left: List of Pending Debts & Add Book -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Conceptos a Cobrar"
                                       Style="{StaticResource TitleLarge}"
                                       VerticalAlignment="Center" />
                            
                            <!-- Botón + Agregar Libro -->
                            <Border Grid.Column="1" Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushSecondary}" VerticalAlignment="Center" Margin="4,0,8,0" />
                                    <ComboBox ItemsSource="{Binding CursosDisponibles}"
                                              DisplayMemberPath="Nombre"
                                              Width="120"
                                              Padding="4,2"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              x:Name="ComboLibros" />
                                    <Button Command="{Binding AgregarLibroCommand}"
                                            CommandParameter="{Binding ElementName=ComboLibros, Path=SelectedItem}"
                                            Style="{StaticResource ButtonSecondary}"
                                            Padding="10,4" Margin="8,0,0,0">
                                        Agregar Libro
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <DataGrid ItemsSource="{Binding ConceptosPendientes}"
                                  AutoGenerateColumns="False"
                                  Style="{StaticResource TableStyle}"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  MinHeight="180"
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="50" Header="">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Seleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="CONCEPTO / DEUDA"
                                                    Binding="{Binding Descripcion}"
                                                    Width="*" />
                                <DataGridTextColumn Header="MONTO"
                                                    Binding="{Binding Monto, StringFormat={}{0:C}}"
                                                    Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Right: Financial Summary & Payment Details -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Detalles del Pago"
                                   Style="{StaticResource TitleLarge}"
                                   Margin="0,0,0,16" />

                        <TextBlock Text="Método de Pago"
                                   Style="{StaticResource LabelMedium}"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding MetodosPago}"
                                  SelectedItem="{Binding MetodoPagoSeleccionado}"
                                  Padding="10,8"
                                  Margin="0,0,0,16" />

                        <TextBlock Text="Monto Recibido ($)"
                                   Style="{StaticResource LabelMedium}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding MontoRecibido, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 Style="{StaticResource InputStyle}"
                                 Padding="10,8"
                                 Margin="0,0,0,16" />

                        <Border Background="{StaticResource BrushSurfaceAlt}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10"
                                Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="TOTAL A COBRAR"
                                           Style="{StaticResource LabelMedium}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalACobrar, StringFormat={}{0:C} MXN}"
                                           Style="{StaticResource TitleLarge}"
                                           Foreground="{StaticResource BrushSecondary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="#F0FDF4"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10">
                            <Grid>
                                <TextBlock Text="CAMBIO A ENTREGAR"
                                           Style="{StaticResource LabelMedium}"
                                           FontWeight="Bold"
                                           Foreground="#166534"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CambioAEntregar, StringFormat={}{0:C} MXN}"
                                           Style="{StaticResource TitleLarge}"
                                           Foreground="#166534"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="#FEF3C7"
                                BorderBrush="#FCD34D"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,10,0,0"
                                Visibility="{Binding EsAbonoParcial, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE783;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="#92400E"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Se registrará como abono parcial."
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#92400E"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer Action Bar (3 Buttons: Cancelar, Imprimir Recibo, Pagado) -->
            <Border Grid.Row="5"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Cancel Button -->
                    <Button Grid.Column="0"
                            Style="{StaticResource ButtonSecondary}"
                            Command="{Binding CancelarCommand}"
                            Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Cancelar"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Right Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource ButtonSecondary}"
                                Command="{Binding ImprimirReciboCommand}"
                                Padding="20,10"
                                Margin="0,0,12,0"
                                IsEnabled="{Binding TieneAlumnoCargado}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Imprimir Recibo"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ButtonPrimary}"
                                Command="{Binding PagadoCommand}"
                                Padding="28,10"
                                IsEnabled="{Binding TieneAlumnoCargado}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="REGISTRAR PAGO"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
